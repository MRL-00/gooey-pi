{
  "draftId": "0ae106c0-e7ec-4bb9-9baa-269c9b7abf90",
  "title": "Prime Desktop Workspace",
  "htmlContent": "<!DOCTYPE html><html lang=\"en\"><head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <script src=\"https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js\"></script>\n  <style>\n    :root {\n      --canvas: #ffffff;\n      --sidebar: #f3f3f1;\n      --surface-subtle: #f7f7f5;\n      --surface-hover: #ececea;\n      --surface-selected: #e5e5e2;\n      --surface-raised: #ffffff;\n      --text: #20201e;\n      --text-secondary: #686863;\n      --text-tertiary: #92928c;\n      --border: #e3e3df;\n      --border-strong: #d3d3ce;\n      --focus: #6aa9ff;\n      --prime: #6b55e8;\n      --prime-soft: #efecff;\n      --success: #288a5b;\n      --success-soft: #eaf5ee;\n      --warning: #9a6b17;\n      --warning-soft: #faf1dc;\n      --danger: #c54b42;\n      --danger-soft: #fbeceb;\n      --diff-add: #e5f3e8;\n      --diff-add-line: #4aa866;\n      --diff-remove: #f9e8e6;\n      --diff-remove-line: #d4675c;\n      --annotation: #2488ff;\n    }\n    \n    body {\n      margin: 0;\n      padding: 0;\n      background: var(--canvas);\n      color: var(--text);\n      font-family: ui-sans-serif, -apple-system, BlinkMacSystemFont, \"SF Pro Text\", sans-serif;\n      font-size: 13px;\n      line-height: 1.45;\n      overflow: hidden;\n    }\n\n    .mac-os-chrome {\n      height: 52px;\n      -webkit-app-region: drag;\n    }\n    \n    .no-drag {\n      -webkit-app-region: no-drag;\n    }\n\n    .mono {\n      font-family: \"SFMono-Regular\", \"SF Mono\", \"Cascadia Code\", Menlo, monospace;\n      font-size: 12.5px;\n      line-height: 1.55;\n    }\n\n    .sidebar-row-active {\n      background-color: var(--surface-selected);\n    }\n\n    .inspector-tab-active {\n      border-bottom: 1.5px solid var(--text);\n      color: var(--text);\n    }\n\n    .traffic-lights {\n      padding-left: 16px;\n      display: flex;\n      gap: 8px;\n      align-items: center;\n      height: 100%;\n    }\n    \n    .light {\n      width: 12px;\n      height: 12px;\n      border-radius: 50%;\n    }\n\n    .custom-scrollbar::-webkit-scrollbar {\n      width: 6px;\n    }\n    .custom-scrollbar::-webkit-scrollbar-thumb {\n      background: #d1d1cf;\n      border-radius: 10px;\n    }\n    .custom-scrollbar::-webkit-scrollbar-track {\n      background: transparent;\n    }\n\n    .pulse-running {\n      animation: pulse 1.6s infinite;\n    }\n\n    @keyframes pulse {\n      0%, 100% { opacity: 1; }\n      50% { opacity: 0.4; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"flex h-screen w-full bg-white overflow-hidden\" data-sd-id=\"1\">\n    \n    <!-- Left Sidebar -->\n    <aside class=\"w-[248px] bg-[#f3f3f1] border-r border-[#e3e3df] flex flex-col h-full shrink-0 select-none\" data-sd-id=\"2\">\n      <!-- Titlebar Area Inset -->\n      <div class=\"h-[52px] flex items-center px-4 shrink-0\" data-sd-id=\"3\">\n        <div class=\"traffic-lights mr-auto\" data-sd-id=\"4\">\n          <div class=\"light bg-[#ff5f57]\" data-sd-id=\"5\"></div>\n          <div class=\"light bg-[#febc2e]\" data-sd-id=\"6\"></div>\n          <div class=\"light bg-[#28c840]\" data-sd-id=\"7\"></div>\n        </div>\n        <button id=\"new-thread-btn\" class=\"p-1.5 rounded-md hover:bg-[#ececea] text-[#686863] flex items-center justify-center\" data-sd-id=\"8\">\n          <iconify-icon icon=\"lucide:square-pen\" width=\"18\"></iconify-icon>\n        </button>\n      </div>\n\n      <div class=\"px-2 py-2 flex flex-col gap-0.5 overflow-y-auto custom-scrollbar flex-1\" data-sd-id=\"9\">\n        <div class=\"px-2 py-1 text-[11px] font-medium text-[#92928c] uppercase tracking-wider mb-1\" data-sd-id=\"10\">Projects</div>\n        \n        <a id=\"sidebar-prime-harness\" href=\"#\" class=\"flex items-center gap-2.5 px-2.5 py-[7px] rounded-[7px] bg-[#e5e5e2] text-[#20201e] group\" data-sd-id=\"11\">\n          <iconify-icon icon=\"lucide:folder\" class=\"text-[#686863]\"></iconify-icon>\n          <span class=\"truncate font-medium\" data-sd-id=\"12\">prime-harness-v2</span>\n          <div class=\"ml-auto flex gap-1\" data-sd-id=\"13\">\n            <div class=\"w-1.5 h-1.5 bg-[#6b55e8] rounded-full pulse-running\" data-sd-id=\"14\"></div>\n          </div>\n        </a>\n\n        <a id=\"sidebar-web-store\" href=\"#\" class=\"flex items-center gap-2.5 px-2.5 py-[7px] rounded-[7px] hover:bg-[#ececea] text-[#686863]\" data-sd-id=\"15\">\n          <iconify-icon icon=\"lucide:folder\"></iconify-icon>\n          <span class=\"truncate\" data-sd-id=\"16\">storefront-redesign</span>\n        </a>\n\n        <div class=\"mt-4 px-2 py-1 text-[11px] font-medium text-[#92928c] uppercase tracking-wider mb-1\" data-sd-id=\"17\">Recent Sessions</div>\n        \n        <a id=\"session-refactor\" href=\"#\" class=\"flex flex-col px-2.5 py-2 rounded-[7px] hover:bg-[#ececea] text-[#686863]\" data-sd-id=\"18\">\n          <div class=\"flex items-center gap-2\" data-sd-id=\"19\">\n            <iconify-icon icon=\"lucide:message-square\" class=\"shrink-0\"></iconify-icon>\n            <span class=\"truncate text-[13px] text-[#20201e]\" data-sd-id=\"20\">Refactor auth provider</span>\n          </div>\n          <span class=\"text-[11px] text-[#92928c] ml-6\" data-sd-id=\"21\">2h ago</span>\n        </a>\n\n        <a id=\"session-debug\" href=\"#\" class=\"flex flex-col px-2.5 py-2 rounded-[7px] hover:bg-[#ececea] text-[#686863]\" data-sd-id=\"22\">\n          <div class=\"flex items-center gap-2\" data-sd-id=\"23\">\n            <iconify-icon icon=\"lucide:message-square\" class=\"shrink-0\"></iconify-icon>\n            <span class=\"truncate text-[13px] text-[#20201e]\" data-sd-id=\"24\">Debug hydration error</span>\n          </div>\n          <span class=\"text-[11px] text-[#92928c] ml-6\" data-sd-id=\"25\">Yesterday</span>\n        </a>\n      </div>\n\n      <!-- Sidebar Footer -->\n      <div class=\"p-3 border-t border-[#e3e3df]\" data-sd-id=\"26\">\n        <a id=\"sidebar-settings\" href=\"#\" class=\"flex items-center gap-2.5 px-2.5 py-[7px] rounded-[7px] hover:bg-[#ececea] text-[#686863]\" data-sd-id=\"27\">\n          <iconify-icon icon=\"lucide:settings\"></iconify-icon>\n          <span class=\"truncate\" data-sd-id=\"28\">Settings</span>\n        </a>\n      </div>\n    </aside>\n\n    <!-- Main Content Area -->\n    <div class=\"flex flex-col flex-1 h-full min-w-0 bg-white relative\" data-sd-id=\"29\">\n      \n      <!-- Main Header Toolbar -->\n      <header class=\"h-[52px] border-b border-[#e3e3df] flex items-center px-4 shrink-0 gap-4\" data-sd-id=\"30\">\n        <div class=\"flex items-center gap-1\" data-sd-id=\"31\">\n          <button id=\"nav-back\" class=\"p-1.5 rounded-md hover:bg-[#ececea] text-[#686863]\" data-sd-id=\"32\">\n            <iconify-icon icon=\"lucide:chevron-left\" width=\"18\"></iconify-icon>\n          </button>\n          <button id=\"nav-forward\" class=\"p-1.5 rounded-md hover:bg-[#ececea] text-[#686863]\" data-sd-id=\"33\">\n            <iconify-icon icon=\"lucide:chevron-right\" width=\"18\"></iconify-icon>\n          </button>\n        </div>\n        \n        <div class=\"flex-1 flex items-center gap-2 overflow-hidden\" data-sd-id=\"34\">\n          <span class=\"text-[12.5px] font-medium text-[#20201e] truncate\" data-sd-id=\"35\">prime-harness-v2</span>\n          <span class=\"text-[#92928c]\" data-sd-id=\"36\">/</span>\n          <div class=\"flex items-center gap-1.5 px-2 py-0.5 bg-[#f7f7f5] border border-[#e3e3df] rounded-md text-[12px] text-[#686863]\" data-sd-id=\"37\">\n            <iconify-icon icon=\"lucide:git-branch\" width=\"14\"></iconify-icon>\n            <span data-sd-id=\"38\">main</span>\n          </div>\n        </div>\n\n        <div class=\"flex items-center gap-2\" data-sd-id=\"39\">\n          <button id=\"run-project\" class=\"flex items-center gap-1.5 px-3 py-1.5 bg-[#20201e] text-white rounded-md text-[12.5px] font-medium\" data-sd-id=\"40\">\n            <iconify-icon icon=\"lucide:play\" width=\"14\"></iconify-icon>\n            <span data-sd-id=\"41\">Run</span>\n          </button>\n          <div class=\"w-px h-4 bg-[#e3e3df]\" data-sd-id=\"42\"></div>\n          <button id=\"toggle-sidebar\" class=\"p-1.5 rounded-md hover:bg-[#ececea] text-[#686863]\" data-sd-id=\"43\">\n            <iconify-icon icon=\"lucide:layout-sidebar\" width=\"18\"></iconify-icon>\n          </button>\n          <button id=\"toggle-inspector\" class=\"p-1.5 rounded-md bg-[#f7f7f5] text-[#20201e]\" data-sd-id=\"44\">\n            <iconify-icon icon=\"lucide:layout-panel-right\" width=\"18\"></iconify-icon>\n          </button>\n        </div>\n      </header>\n\n      <!-- Main Chat Body -->\n      <main class=\"flex-1 overflow-y-auto custom-scrollbar flex flex-col pt-8 pb-32\" data-sd-id=\"45\">\n        <div class=\"max-w-[760px] w-full mx-auto px-6 space-y-8\" data-sd-id=\"46\">\n          \n          <!-- User Message -->\n          <div class=\"flex justify-end\" data-sd-id=\"47\">\n            <div class=\"bg-[#f7f7f5] rounded-2xl px-4 py-2.5 text-[14px] max-w-[85%]\" data-sd-id=\"48\">\n              Add a search bar to the dashboard and connect it to the product API. It should update the list in real-time.\n            </div>\n          </div>\n\n          <!-- Assistant Message -->\n          <div class=\"flex flex-col gap-4\" data-sd-id=\"49\">\n            <div class=\"flex items-start gap-3\" data-sd-id=\"50\">\n              <div class=\"w-6 h-6 rounded-full bg-[#6b55e8] flex items-center justify-center shrink-0 mt-0.5\" data-sd-id=\"51\">\n                <iconify-icon icon=\"lucide:zap\" class=\"text-white text-[14px]\"></iconify-icon>\n              </div>\n              <div class=\"flex-1 text-[14px] leading-[1.62] space-y-4\" data-sd-id=\"52\">\n                <p data-sd-id=\"53\">I'll implement the search functionality. I'll need to create a new <code>SearchBar</code> component, update the dashboard layout, and integrate the API filtering logic.</p>\n                \n                <!-- Tool Activity Timeline -->\n                <div class=\"border border-[#e3e3df] rounded-lg overflow-hidden bg-[#f7f7f5]\" data-sd-id=\"54\">\n                  <div class=\"flex items-center gap-2 px-3 py-2 border-b border-[#e3e3df] text-[12px] font-medium\" data-sd-id=\"55\">\n                    <iconify-icon icon=\"lucide:cpu\" class=\"text-[#686863]\"></iconify-icon>\n                    <span data-sd-id=\"56\">Tool execution history</span>\n                  </div>\n                  <div class=\"p-2 space-y-1\" data-sd-id=\"57\">\n                    <div class=\"flex items-center gap-2 px-2 py-1 text-[12px] text-[#686863]\" data-sd-id=\"58\">\n                      <iconify-icon icon=\"lucide:check-circle-2\" class=\"text-[#288a5b]\"></iconify-icon>\n                      <span data-sd-id=\"59\">Read <code>src/components/Dashboard.tsx</code></span>\n                      <span class=\"ml-auto text-[#92928c] font-mono\" data-sd-id=\"60\">142ms</span>\n                    </div>\n                    <div class=\"flex items-center gap-2 px-2 py-1 text-[12px] text-[#686863]\" data-sd-id=\"61\">\n                      <iconify-icon icon=\"lucide:check-circle-2\" class=\"text-[#288a5b]\"></iconify-icon>\n                      <span data-sd-id=\"62\">Read <code>src/api/products.ts</code></span>\n                      <span class=\"ml-auto text-[#92928c] font-mono\" data-sd-id=\"63\">88ms</span>\n                    </div>\n                    <div class=\"flex items-center gap-2 px-2 py-1 text-[12px] text-[#20201e]\" data-sd-id=\"64\">\n                      <div class=\"w-3 h-3 border-2 border-[#6b55e8] border-t-transparent rounded-full animate-spin\" data-sd-id=\"65\"></div>\n                      <span class=\"font-medium\" data-sd-id=\"66\">Writing files...</span>\n                    </div>\n                  </div>\n                </div>\n\n                <!-- Changed Files Summary Card -->\n                <div class=\"border border-[#e3e3df] rounded-lg p-3 flex items-center justify-between hover:bg-[#fcfcfc] transition-colors cursor-pointer\" data-sd-id=\"67\">\n                  <div class=\"flex items-center gap-3\" data-sd-id=\"68\">\n                    <div class=\"w-8 h-8 rounded bg-[#eaf5ee] flex items-center justify-center\" data-sd-id=\"69\">\n                      <iconify-icon icon=\"lucide:file-code\" class=\"text-[#288a5b]\"></iconify-icon>\n                    </div>\n                    <div data-sd-id=\"70\">\n                      <div class=\"text-[13px] font-medium\" data-sd-id=\"71\">3 files modified</div>\n                      <div class=\"text-[11px] text-[#92928c]\" data-sd-id=\"72\">Applied successfully</div>\n                    </div>\n                  </div>\n                  <div class=\"flex items-center gap-1.5\" data-sd-id=\"73\">\n                    <span class=\"text-[11px] px-1.5 py-0.5 bg-[#e5f3e8] text-[#288a5b] rounded font-mono\" data-sd-id=\"74\">+42</span>\n                    <span class=\"text-[11px] px-1.5 py-0.5 bg-[#f9e8e6] text-[#c54b42] rounded font-mono\" data-sd-id=\"75\">-12</span>\n                    <iconify-icon icon=\"lucide:chevron-right\" class=\"text-[#92928c]\"></iconify-icon>\n                  </div>\n                </div>\n\n                <p data-sd-id=\"76\">The changes are now ready. I've updated the UI to include a debounced search input that triggers re-fetches from the product API.</p>\n              </div>\n            </div>\n          </div>\n\n        </div>\n      </main>\n\n      <!-- Floating Composer Area -->\n      <div class=\"absolute bottom-0 left-0 right-0 px-6 pb-6 pointer-events-none\" data-sd-id=\"77\">\n        <div class=\"max-w-[760px] w-full mx-auto pointer-events-auto\" data-sd-id=\"78\">\n          <div class=\"bg-white border border-[#d3d3ce] rounded-2xl shadow-[0_1px_4px_rgba(0,0,0,0.06)] flex flex-col p-2\" data-sd-id=\"79\">\n            <textarea class=\"w-full px-4 py-2 text-[14px] placeholder-[#92928c] outline-none resize-none min-h-[60px]\" placeholder=\"Ask Prime anything, @ to add files, / for commands\" data-sd-id=\"80\"></textarea>\n            <div class=\"flex items-center justify-between px-2 pb-1\" data-sd-id=\"81\">\n              <div class=\"flex items-center gap-1.5\" data-sd-id=\"82\">\n                <button id=\"attach-btn\" class=\"p-2 rounded-md hover:bg-[#ececea] text-[#686863]\" data-sd-id=\"83\">\n                  <iconify-icon icon=\"lucide:plus\" width=\"18\"></iconify-icon>\n                </button>\n                \n                <!-- Composer Controls -->\n                <div class=\"flex items-center bg-[#f7f7f5] rounded-full px-2 py-1 gap-2 border border-[#e3e3df]\" data-sd-id=\"84\">\n                  <div class=\"flex items-center gap-1 text-[11px] font-medium text-[#686863]\" data-sd-id=\"85\">\n                    <iconify-icon icon=\"lucide:sparkles\" width=\"12\" class=\"text-[#6b55e8]\"></iconify-icon>\n                    <span data-sd-id=\"86\">Prime-2.0</span>\n                  </div>\n                  <div class=\"w-px h-2.5 bg-[#d3d3ce]\" data-sd-id=\"87\"></div>\n                  <div class=\"flex items-center gap-1 text-[11px] font-medium text-[#686863]\" data-sd-id=\"88\">\n                    <iconify-icon icon=\"lucide:zap\" width=\"12\"></iconify-icon>\n                    <span data-sd-id=\"89\">Standard</span>\n                  </div>\n                  <div class=\"w-px h-2.5 bg-[#d3d3ce]\" data-sd-id=\"90\"></div>\n                  <div class=\"flex items-center gap-1 text-[11px] font-medium text-[#686863]\" data-sd-id=\"91\">\n                    <iconify-icon icon=\"lucide:hard-drive\" width=\"12\"></iconify-icon>\n                    <span data-sd-id=\"92\">Local</span>\n                  </div>\n                </div>\n              </div>\n              \n              <button id=\"send-btn\" class=\"w-8 h-8 rounded-full bg-[#20201e] text-white flex items-center justify-center\" data-sd-id=\"93\">\n                <iconify-icon icon=\"lucide:arrow-up\" width=\"18\"></iconify-icon>\n              </button>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- Right Contextual Inspector -->\n    <aside class=\"w-[46%] border-l border-[#e3e3df] flex flex-col h-full shrink-0 bg-white\" data-sd-id=\"94\">\n      \n      <!-- Inspector Header Tabs -->\n      <div class=\"h-[52px] border-b border-[#e3e3df] flex items-center px-4 shrink-0 justify-between\" data-sd-id=\"95\">\n        <div class=\"flex h-full\" data-sd-id=\"96\">\n          <button class=\"px-4 flex items-center text-[13px] text-[#686863] border-b-2 border-transparent\" data-sd-id=\"97\">Summary</button>\n          <button class=\"px-4 flex items-center text-[13px] text-[#686863] border-b-2 border-transparent\" data-sd-id=\"98\">Changes</button>\n          <button class=\"px-4 flex items-center text-[13px] text-[#20201e] border-b-2 border-[#20201e] font-medium\" data-sd-id=\"99\">Browser</button>\n          <button class=\"px-4 flex items-center text-[#92928c]\" data-sd-id=\"100\">\n            <iconify-icon icon=\"lucide:plus\" width=\"16\"></iconify-icon>\n          </button>\n        </div>\n        <div class=\"flex items-center gap-2\" data-sd-id=\"101\">\n          <button class=\"p-1.5 rounded-md hover:bg-[#ececea] text-[#686863]\" data-sd-id=\"102\">\n            <iconify-icon icon=\"lucide:maximize-2\" width=\"16\"></iconify-icon>\n          </button>\n        </div>\n      </div>\n\n      <!-- Browser Panel -->\n      <div class=\"flex-1 flex flex-col overflow-hidden relative\" data-sd-id=\"103\">\n        \n        <!-- Browser Toolbar -->\n        <div class=\"h-10 border-b border-[#e3e3df] flex items-center px-3 gap-3 bg-[#fcfcfc]\" data-sd-id=\"104\">\n          <div class=\"flex items-center gap-1\" data-sd-id=\"105\">