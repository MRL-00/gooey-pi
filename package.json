{
  "name": "prime-work",
  "version": "0.1.0",
  "private": true,
  "description": "A native-feeling desktop workspace for Prime Agent",
  "main": "out/main/index.js",
  "author": "Prime Work contributors",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && npm run build:bundle",
    "build:bundle": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "biome lint --config-path=scripts/release/biome.json electron src tests scripts electron.vite.config.ts playwright.config.ts vitest.config.ts",
    "format:check": "biome format --config-path=scripts/release/biome.json scripts/release electron.vite.config.ts vitest.config.ts playwright.config.ts tests/release-scripts.test.ts",
    "check": "npm run lint && npm run format:check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && npm run test:e2e:hermetic",
    "test:e2e:hermetic": "playwright test",
    "release:verify": "npm run typecheck && npm run check && npm run test:coverage && npm run build:bundle && npm run test:e2e:hermetic",
    "package:mac": "node scripts/release/package.mjs --public",
    "package:mac:local-qa": "node scripts/release/package.mjs --qa",
    "release:preflight": "node scripts/release/preflight.mjs",
    "postinstall": "PYTHON=/usr/bin/python3 electron-builder install-app-deps"
  },
  "dependencies": {
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@electron/asar": "^4.2.1",
    "@electron/fuses": "^2.1.3",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.7",
    "electron-vite": "^5.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^5.7.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "ai.prime.work",
    "productName": "Prime Work",
    "asar": {
      "smartUnpack": false
    },
    "asarUnpack": [
      "**/node_modules/node-pty/build/Release/pty.node",
      "**/node_modules/node-pty/build/Release/spawn-helper"
    ],
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "icon": "assets/icon.icns",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "notarize": true
    },
    "directories": {
      "output": "release"
    },
    "afterPack": "scripts/release/after-pack.cjs",
    "extraResources": [
      {
        "from": "assets/icon.png",
        "to": "icon.png"
      }
    ],
    "electronLanguages": [
      "en-US"
    ]
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.9.0"
  },
  "packageManager": "npm@11.12.1"
}
