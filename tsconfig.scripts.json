{
  "compilerOptions": {
    "target": "ES2022",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": true,
    "strict": false,
    "types": ["node"]
  },
  "include": ["scripts/**/*.mjs", "scripts/**/*.cjs"]
}
