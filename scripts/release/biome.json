{
  "$schema": "../../node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": ["**", "!out", "!release", "!coverage", "!node_modules", "!test-results", "!playwright-report"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 200
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "security": {
        "preset": "all",
        "noSecrets": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "noDescendingSpecificity": "off"
      },
      "a11y": {
        "noAutofocus": "off",
        "noLabelWithoutControl": "off",
        "noNoninteractiveTabindex": "off",
        "noStaticElementInteractions": "off",
        "useAriaPropsSupportedByRole": "off",
        "useSemanticElements": "off"
      },
      "correctness": {
        "useExhaustiveDependencies": "off"
      },
      "suspicious": {
        "noArrayIndexKey": "off",
        "noTemplateCurlyInString": "off"
      },
      "complexity": {
        "noImportantStyles": "off"
      }
    }
  },
  "root": false
}
