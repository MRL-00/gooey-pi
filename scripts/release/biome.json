{
  "$schema": "../../node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": ["**", "!out", "!release", "!coverage", "!node_modules", "!test-results", "!playwright-report"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 200
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none",
      "security": {
        "preset": "all",
        "noSecrets": "off"
      },
      "correctness": {
        "noConstAssign": "error",
        "noSelfAssign": "error",
        "noUnreachable": "error"
      },
      "suspicious": {
        "noDuplicateObjectKeys": "error",
        "noDuplicateCase": "error",
        "noDoubleEquals": "error",
        "noDebugger": "error"
      }
    }
  },
  "root": false
}
